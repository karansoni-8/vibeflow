# VibeFlow Environment Configuration
# Copy this file to .env and fill in your values

# ─── Gemini AI ───
# Get your key at: https://aistudio.google.com/apikey
VIBE_GEMINI_KEY=

# ─── Firebase Auth ───
# Create a project at: https://console.firebase.google.com
# Enable Google and GitHub sign-in providers
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ─── Server ───
VIBE_JWT_SECRET=vibeflow-dev-secret-change-in-production
VIBE_EXEC_TIMEOUT=5000
PORT=3001

# ─── Development Mode ───
# Set to true to bypass Firebase auth (uses a mock dev user)
VIBE_DEV_MODE=true
